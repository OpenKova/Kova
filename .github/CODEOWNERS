# Paths that need a kova-agent-core approval before merge. This replaces the
# ``ci-reviewed`` label gate: GitHub requests the review and enforces it
# (ruleset: "Require review from Code Owners"), so CI no longer needs to
# classify these paths, check a label, or rerun jobs when one is added.
#
# Last match wins; every rule below has the same owner, so order is moot.
# Patterns without a leading slash match at any depth.

# Workflows, composite actions, and this file: they decide what CI executes
# and what the autofix job pushes to main. The scripts the workflows run get the
# same review for the same reason.
/.github/                       @NeuralStudio/kova-agent-core
/scripts/ci/                    @NeuralStudio/kova-agent-core
# The code-health gate decides whether a PR passes; weakening it is a CI change.
/scripts/check                  @NeuralStudio/kova-agent-core
/scripts/code_health/           @NeuralStudio/kova-agent-core

# The committed system prompt + tools[] render every session sends (scripts/ci/prompt_surface.py).
# The prompt-surface-review ruleset requires one kova-agent-core approval here; this line requests it.
/tests/fixtures/prompt_surface/ @NeuralStudio/kova-agent-core

# eslint configs can define custom ``fix`` functions that run arbitrary code.
eslint.config.*                 @NeuralStudio/kova-agent-core
/.prettierrc                    @NeuralStudio/kova-agent-core

# MCP catalog entries define local commands users later install into
# ``mcp_servers``; the installer decides how they are fetched and run.
/optional-mcps/                 @NeuralStudio/kova-agent-core
/kova_cli/mcp_catalog.py      @NeuralStudio/kova-agent-core

# Files that execute at pip-install or interpreter startup.
/setup.py                       @NeuralStudio/kova-agent-core
/setup.cfg                      @NeuralStudio/kova-agent-core
/sitecustomize.py               @NeuralStudio/kova-agent-core
/usercustomize.py               @NeuralStudio/kova-agent-core
*.pth                           @NeuralStudio/kova-agent-core

# Dependency manifests, resolved pins, and image builds: an edit here changes
# what gets installed and run without touching any reviewed source.
pyproject.toml                  @NeuralStudio/kova-agent-core
package.json                    @NeuralStudio/kova-agent-core
uv.lock                         @NeuralStudio/kova-agent-core
*package-lock.json              @NeuralStudio/kova-agent-core
/pnpm-lock.yaml                 @NeuralStudio/kova-agent-core
/flake.lock                     @NeuralStudio/kova-agent-core
/pm/lock.json                   @NeuralStudio/kova-agent-core
*Dockerfile                     @NeuralStudio/kova-agent-core

# A root .npmrc (registry, auth) would apply to every pnpm install.
.npmrc                          @NeuralStudio/kova-agent-core
# The pnpm workspace's quarantine (minimumReleaseAge), its overrides, and the
# dependencies allowed to run build scripts (allowBuilds) live here.
/pnpm-workspace.yaml            @NeuralStudio/kova-agent-core

# Where PM fetches artifacts from.
/pm/artifact-mirror.json        @NeuralStudio/kova-agent-core

# The installers users pipe into a shell, and the generator for the pins they carry.
/scripts/install.sh             @NeuralStudio/kova-agent-core
/scripts/install.ps1            @NeuralStudio/kova-agent-core
/scripts/install.cmd            @NeuralStudio/kova-agent-core
/scripts/gen-bootstrap-pins.py  @NeuralStudio/kova-agent-core

# The trust model and the scope authority for security reports.
/SECURITY.md                    @NeuralStudio/kova-agent-core

